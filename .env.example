# --- Required ---
GROQ_API_KEY=your_groq_api_key

# News provider: set ONE of these. NEWSDATA_API_KEY is used automatically if present.
NEWSDATA_API_KEY=your_newsdata_api_key
FREENEWSAPI_API_KEY=your_news_api_key
# NEWS_PROVIDER=newsdata   # optional override: "newsdata" or "freenewsapi"

# --- Storage ---
DATABASE_URL=sqlite:///./data/news_agent.db

# --- Optional tuning (defaults shown) ---
GROQ_MODEL=llama-3.3-70b-versatile
FREENEWSAPI_BASE_URL=https://api.freenewsapi.io
NEWS_LANGUAGE=en
NEWS_COUNTRY=
FREENEWSAPI_ORDER_BY=
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
LOOKBACK_HOURS=48
ARTICLES_PER_QUERY=8
MAX_ARTICLES_TO_PROCESS=60
MAX_ARTICLES_TO_SUMMARIZE=24
RELEVANCE_THRESHOLD=0.45
DEDUPE_SIMILARITY=0.85
DIGEST_PER_SUBTOPIC=5

# --- Trending topics ---
TRENDING_BASELINE_DAYS=7
TRENDING_MIN_COUNT=3
TRENDING_RATIO=1.6

# --- Email (daily digest via Gmail SMTP) ---
# Create an app password at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Scheduler / deployment (used when hosted, e.g. on Render - see README_DEPLOY.md) ---
CORS_ORIGINS=http://localhost:5173
